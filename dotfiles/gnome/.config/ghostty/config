# 设置主题
theme = Matugen 
command = /usr/bin/fish

#光标样式
cursor-style=bar
#设置窗口大小
window-height=25
window-width=82
#设置透明度
background-opacity=0.90
#设置字体
font-family= "CaskaydiaMono Nerd Font" 
font-size = 15
#取消关闭时的确认
confirm-close-surface = false
#设置左右边距
window-padding-x=10
#设置上下边距
window-padding-y=10
